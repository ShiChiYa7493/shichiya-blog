node_modules/
packages/frontend/.next/
packages/server/dist/
packages/wf-bot/plugins/*/lib/
packages/wf-bot/plugins/*/tsconfig.tsbuildinfo
# external/ 是 koishi-plugin-warframe 的 fork（GPL-3.0，自带 git 仓库）。
# 不随本仓库（Apache-2.0）分发，保持许可边界干净；部署时单独 clone。
packages/wf-bot/external/
# NapCat 的运行数据：ntqq/ 是 QQ 登录态，config/ 含 token，都不能入库
packages/wf-bot/napcat/ntqq/
packages/wf-bot/napcat/config/
# Koishi 持久化数据库、运行缓存和下载的背景图
packages/wf-bot/data/
.env
.env.local
.env.production
packages/frontend/.env*
packages/server/.env*
!packages/frontend/.env.example
!packages/server/.env.example
uploads/*
!uploads/.gitkeep
.DS_Store
.vscode/
.idea/
*.log
.superpowers/
# docs/ 默认整体忽略（博客草稿等），仅放行设计文档 docs/superpowers/specs/。
# 注意：必须写成 docs/* 而不是 docs/ —— 父目录若被整体排除，
# git 不会进入该目录，下面的 ! 例外将全部失效。
docs/superpowers/*
